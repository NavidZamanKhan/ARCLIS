# Copy to .env and load it before running Django in local development.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable interactive execution for a single loopback development server.
# ARCLIS_ENABLE_LOCAL_EXECUTION=1

# Optional overrides. A dedicated secret is required when debug mode is off.
# DJANGO_SECRET_KEY=
# DJANGO_SQLITE_PATH=
