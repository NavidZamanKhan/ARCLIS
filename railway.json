{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deployment/Dockerfile",
    "watchPatterns": ["/backend/**", "/deployment/Dockerfile", "/.dockerignore", "/railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/api/v1/health/",
    "healthcheckTimeout": 30
  }
}
